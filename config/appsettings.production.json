{
  "odoo": {
    "mode": "jsonrpc"
  },
  "agent": {
    "mode": "openai"
  },
  "session_store": {
    "mode": "hybrid"
  },
  "observability": {
    "environment": "production"
  },
  "telemetry": {
    "enabled": true,
    "service_name": "sumampa-odoo-agent",
    "environment": "production",
    "cluster": "production",
    "otlp_endpoint": "https://otel.orchid-labs.xyz:443",
    "otlp_protocol": "grpc",
    "traces_enabled": true,
    "metrics_enabled": true,
    "logs_enabled": true,
    "sample_rate": 1.0,
    "capture_payloads": true
  }
}
