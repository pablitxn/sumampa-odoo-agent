{
  "service": {
    "name": "sumampa-odoo-agent",
    "version": "0.1.0",
    "host": "0.0.0.0",
    "port": 8000
  },
  "logging": {
    "level": "INFO",
    "format": "json"
  },
  "odoo": {
    "mode": "dry-run",
    "base_url": "http://localhost:8069",
    "database": "sumampa",
    "username": "admin",
    "password": "",
    "timeout_seconds": 15.0
  },
  "agent": {
    "mode": "openai",
    "model": "gpt-5.4-mini",
    "api_key_env_var": "OPENAI_API_KEY",
    "base_url": null,
    "system_prompt_spec": "agent/system.md",
    "system_prompt_override": null
  },
  "session_store": {
    "mode": "memory",
    "postgres_dsn": "",
    "redis_url": "redis://127.0.0.1:6379/0",
    "redis_ttl_seconds": 86400,
    "redis_key_prefix": "sumampa:session"
  }
}
