{
  "service": {
    "name": "sumampa-odoo-agent",
    "version": "0.1.0",
    "host": "0.0.0.0",
    "port": 8000
  },
  "logging": {
    "level": "INFO",
    "format": "json"
  },
  "odoo": {
    "mode": "dry-run",
    "base_url": "http://localhost:8069",
    "database": "sumampa",
    "username": "admin",
    "password": "",
    "timeout_seconds": 15.0
  },
  "agent": {
    "mode": "disabled",
    "model": "gpt-5.4-mini",
    "api_key_env_var": "OPENAI_API_KEY",
    "base_url": null,
    "system_prompt": "Sos un asistente operativo de Sumampa para Odoo. Antes de proponer cambios pedis los datos faltantes y explicitás el impacto en Odoo."
  },
  "invoice_extraction": {
    "mode": "openai",
    "model": "gpt-5.4",
    "api_key_env_var": "OPENAI_API_KEY",
    "base_url": null,
    "max_output_tokens": 3000
  },
  "purchase_chat": {
    "mode": "openai",
    "model": "gpt-5.4",
    "api_key_env_var": "OPENAI_API_KEY",
    "base_url": null
  }
}
