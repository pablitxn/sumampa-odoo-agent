{
  "service": {
    "name": "sumampa-odoo-agent",
    "version": "0.1.0",
    "host": "0.0.0.0",
    "port": 8000
  },
  "logging": {
    "level": "INFO",
    "format": "json"
  },
  "odoo": {
    "mode": "dry-run",
    "base_url": "http://localhost:8069",
    "database": "sumampa",
    "username": "admin",
    "password": "",
    "timeout_seconds": 15.0
  },
  "agent": {
    "mode": "openai",
    "model": "gpt-5.4-mini",
    "api_key_env_var": "OPENAI_API_KEY",
    "base_url": null,
    "system_prompt_override": null
  },
  "session_store": {
    "mode": "memory",
    "postgres_dsn": "",
    "redis_url": "redis://127.0.0.1:6379/0",
    "redis_ttl_seconds": 86400,
    "redis_key_prefix": "sumampa:session"
  },
  "attachments": {
    "store_mode": "s3",
    "bucket_name": "sumampa-attachments",
    "endpoint_url": "http://127.0.0.1:9000",
    "access_key": null,
    "secret_key": null,
    "access_key_env_var": "ATTACHMENT_STORE_ACCESS_KEY",
    "secret_key_env_var": "ATTACHMENT_STORE_SECRET_KEY",
    "region_name": "us-east-1",
    "key_prefix": "attachments",
    "retention_ttl_seconds": 604800,
    "max_attachment_bytes": 26214400,
    "max_text_chars": 200000,
    "max_pdf_pages": 5
  },
  "observability": {
    "mode": "disabled",
    "environment": "development",
    "capture_mode": "full",
    "sample_rate": 1.0,
    "public_key_env_var": "LANGFUSE_PUBLIC_KEY",
    "secret_key_env_var": "LANGFUSE_SECRET_KEY",
    "base_url": "http://localhost:3000",
    "flush_on_shutdown": true
  },
  "telemetry": {
    "enabled": false,
    "service_name": "sumampa-odoo-agent",
    "environment": "development",
    "cluster": "local",
    "otlp_endpoint": "http://127.0.0.1:4317",
    "otlp_protocol": "grpc",
    "traces_enabled": true,
    "metrics_enabled": true,
    "logs_enabled": true,
    "sample_rate": 1.0,
    "capture_payloads": true
  }
}
