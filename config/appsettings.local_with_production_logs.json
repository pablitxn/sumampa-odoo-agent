{
  "logging": {
    "level": "INFO",
    "format": "json"
  },
  "service": {
    "port": 8000
  },
  "odoo": {
    "mode": "dry-run"
  },
  "agent": {
    "mode": "openai"
  },
  "observability": {
    "environment": "local",
    "base_url": "http://localhost:6006",
    "collector_endpoint": "http://localhost:6006/v1/traces",
    "project_name": "sumampa-odoo-agent"
  },
  "telemetry": {
    "enabled": true,
    "service_name": "sumampa-odoo-agent",
    "environment": "local",
    "cluster": "local",
    "otlp_endpoint": "http://127.0.0.1:4317",
    "otlp_protocol": "grpc",
    "traces_enabled": true,
    "metrics_enabled": true,
    "logs_enabled": true,
    "sample_rate": 1.0,
    "capture_payloads": true
  }
}
