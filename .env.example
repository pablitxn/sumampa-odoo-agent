# Runtime environment
ORCHID_ENV=development

# Agent provider
OPENAI_API_KEY=replace-me
ORCHID_AGENT_SYSTEM_PROMPT_OVERRIDE=

# Odoo local / integration
ORCHID_ODOO_BASE_URL=http://127.0.0.1:8069
ORCHID_ODOO_DATABASE=sumampa_integration
ORCHID_ODOO_USERNAME=admin
ORCHID_ODOO_PASSWORD=
ODOO_MASTER_PASSWORD=

# Conversational session persistence
ORCHID_SESSION_STORE_MODE=memory
ORCHID_SESSION_STORE_POSTGRES_DSN=
ORCHID_SESSION_STORE_REDIS_URL=redis://127.0.0.1:6379/0
ORCHID_SESSION_STORE_REDIS_TTL_SECONDS=86400
