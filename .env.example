# Runtime environment
PYTHON_ENV=development

# Agent provider
OPENAI_API_KEY=replace-me
AGENT_SYSTEM_PROMPT_OVERRIDE=

# Odoo local / integration
ODOO_BASE_URL=http://127.0.0.1:8069
ODOO_DATABASE=sumampa_integration
ODOO_USERNAME=admin
ODOO_PASSWORD=
ODOO_MASTER_PASSWORD=

# Conversational session persistence
SESSION_STORE_MODE=memory
SESSION_STORE_POSTGRES_DSN=
SESSION_STORE_REDIS_URL=redis://127.0.0.1:6379/0
SESSION_STORE_REDIS_TTL_SECONDS=86400

# Phoenix observability
OBSERVABILITY_MODE=phoenix
PHOENIX_BASE_URL=http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=sumampa-odoo-agent
PHOENIX_API_KEY_ENV_VAR=PHOENIX_API_KEY
PHOENIX_API_KEY=

ATTACHMENT_STORE_ACCESS_KEY=

ATTACHMENT_STORE_SECRET_KEY=

MINIO_ROOT_USER=

MINIO_ROOT_PASSWORD=

POSTGRES_PASSWORD=

ODOO_DB_PASSWORD=

PHOENIX_POSTGRES_PASSWORD=

PHOENIX_SQL_DATABASE_URL=

GRAFANA_ADMIN_PASSWORD=
